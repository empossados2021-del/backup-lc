# Copie para .env para mudar os padrões do compose.yaml. Nunca coloque segredos aqui.
# Segredos ficam em arquivos (gerados por scripts/init.sh).

# Diretório de dados no host (banco + configurações coletadas)
BLC_DATA_HOST=/var/lib/backup-lc
# Diretório dos arquivos de segredo no host
BLC_SECRETS_DIR=/etc/backup-lc/secrets
# Porta local (sempre em 127.0.0.1 — ADR-011)
BLC_PORT=8080
# DEBUG, INFO, WARNING ou ERROR
BLC_LOG_LEVEL=INFO
